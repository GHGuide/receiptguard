# Copy to .env and fill. NEVER commit .env.
# Leave DASHSCOPE_API_KEY empty to run in deterministic MOCK mode (no network, full demo works).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
RG_MODEL_AGENT=qwen3-max
RG_MODEL_WORKER=qwen-flash
RG_MODEL_EMBED=text-embedding-v4
# HMAC secret for tool receipts. Generate a real one for deploy: python -c "import secrets;print(secrets.token_hex(32))"
RG_RECEIPT_SECRET=dev-only-insecure-secret-change-me
# SQLite path for the append-only audit ledger (RDS PostgreSQL DSN in prod).
RG_LEDGER_PATH=receiptguard_ledger.db
RG_THINKING_BUDGET=2048
